    <ns2:IAO_0000115 xml:lang="en">An administrative note of use for a curator but of no use for a user</ns2:IAO_0000115>
    <ns2:IAO_0000117 xml:lang="en">PERSON:Alan Ruttenberg</ns2:IAO_0000117>
    <ns2:IAO_0000111 xml:lang="en">curator note</ns2:IAO_0000111>
