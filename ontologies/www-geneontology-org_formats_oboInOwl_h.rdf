    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
    <owl:annotatedTarget>relation between a relation and a human-readable term used to stand in for its identifier</owl:annotatedTarget>
    <hasDbXref>oboInOwl:jpb</hasDbXref>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf8fbcf83cac04be3886e40253a511f10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="http://www.geneontology.org/formats/oboInOwl#inSubset"/>
    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
    <owl:annotatedTarget>relation between a class and a oboInOwl:Subset, indicating the class belongs (is a member of) the subset</owl:annotatedTarget>
    <hasDbXref>oboInOwl:cjm</hasDbXref>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115>pseudo-class. in the oboInOwl translation, all obsolete classes are subclasses of this class. Note that this is not a metaclass</obo:IAO_0000115>
    <hasOBONamespace>oboInOwl</hasOBONamespace>
    <id>oboInOwl:ObsoleteClass</id>
    <rdfs:label>obsolete_class</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#DbXref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <hasDbXref>http://www.w3.org/2000/01/rdf-schema#seeAlso</hasDbXref>
