  <rdf:Description rdf:about="http://www.geneontology.org/formats/oboInOwl#Definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115>The textual definition of the current term. There must be zero or one instances of this tag per term description</obo:IAO_0000115>
    <hasDbXref>http://www.obofoundry.org/wiki/index.php/Definitions</hasDbXref>
    <hasOBONamespace>oboInOwl</hasOBONamespace>
    <id>oboInOwl:Definition</id>
    <rdfs:comment>we are forced to use the n-ary relation pattern in OWL1.0. For OWL2 we may make this a direct axiom between a class and the string</rdfs:comment>
    <rdfs:label>definition</rdfs:label>
  </rdf:Description>
