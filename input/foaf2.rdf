    <x_1999:xhtmlcode>
      <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:name</x_1999:xhtmla>
    </x_1999:xhtmlcode>
  </x_1999:xhtmlp>
  <x_1999:xhtmldiv>
    <x_1999:xhtmlcode/>
  </x_1999:xhtmldiv>
  <x_1999:xhtmlp>
    <x_1999:xhtmla/>
  </x_1999:xhtmlp>
  <x_1999:xhtmlp>
    <x_1999:xhtmlcode>
      <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:name</x_1999:xhtmla>
    </x_1999:xhtmlcode>
  </x_1999:xhtmlp>
  <x_1999:xhtmlp>
    <x_1999:xhtmla/>
  </x_1999:xhtmlp>
  <x_1999:xhtmlh3 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property: foaf:name</x_1999:xhtmlh3>
  <x_1999:xhtmlem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name</x_1999:xhtmlem>
  <x_1999:xhtmlbr rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></x_1999:xhtmlbr>
  <x_1999:xhtmlp rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
XML language tagging may be used to indicate the language of the name. For example:
</x_1999:xhtmlp>
</x_1999:xhtmldiv>

<x_1999:xhtmltr>
  <x_1999:xhtmlth rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Status:</x_1999:xhtmlth>
  <x_1999:xhtmltd rdf:datatype="http://www.w3.org/2001/XMLSchema#string">testing</x_1999:xhtmltd>
</x_1999:xhtmltr>

<x_1999:xhtmltr>
  <x_1999:xhtmlth rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Domain:</x_1999:xhtmlth>
  <x_1999:xhtmltd rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.w3.org/2002/07/owl#Thing</x_1999:xhtmltd>
</x_1999:xhtmltr>

<x_1999:xhtmlbr/>

<x_1999:xhtmldiv>
  <x_1999:xhtmltable>
    <x_1999:xhtmltr>
      <x_1999:xhtmlth rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Status:</x_1999:xhtmlth>
      <x_1999:xhtmltd rdf:datatype="http://www.w3.org/2001/XMLSchema#string">testing</x_1999:xhtmltd>
    </x_1999:xhtmltr>
  </x_1999:xhtmltable>
  <x_1999:xhtmlp>
    <x_1999:xhtmlcode>
      <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:Person</x_1999:xhtmla>
    </x_1999:xhtmlcode>
  </x_1999:xhtmlp>
  <x_1999:xhtmlp>
    <x_1999:xhtmlcode>
      <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:OnlineAccount</x_1999:xhtmla>
    </x_1999:xhtmlcode>
  </x_1999:xhtmlp>
  <x_1999:xhtmlp>
    <x_1999:xhtmla/>
  </x_1999:xhtmlp>
  <x_1999:xhtmlh3 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property: foaf:nick</x_1999:xhtmlh3>
  <x_1999:xhtmlem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nickname</x_1999:xhtmlem>
  <x_1999:xhtmlbr rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></x_1999:xhtmlbr>
  <x_1999:xhtmlp rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
This property is necessarily vague, because it does not indicate any particular naming 
control authority, and so cannot distinguish a person's login from their (possibly 
various) IRC nicknames or other similar identifiers. However it has some utility, since 
many people use the same string (or slight variants) across a variety of such 
environments.
</x_1999:xhtmlp>
</x_1999:xhtmldiv>

