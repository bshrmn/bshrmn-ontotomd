</x_1999:xhtmltr>

<x_1999:xhtmlcode>
  <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:geekcode</x_1999:xhtmla>
</x_1999:xhtmlcode>

