  <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:workInfoHomepage</x_1999:xhtmla>
</x_1999:xhtmlcode>

<x_1999:xhtmlcode>
  <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:Person</x_1999:xhtmla>
</x_1999:xhtmlcode>

<x_1999:xhtmlcode>
  <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:Document</x_1999:xhtmla>
</x_1999:xhtmlcode>

<x_1999:xhtmlcode>
  <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:homepage</x_1999:xhtmla>
</x_1999:xhtmlcode>

<x_1999:xhtmlbr/>

<x_1999:xhtmldiv>
  <x_1999:xhtmltable>
    <x_1999:xhtmltr>
      <x_1999:xhtmltd>
        <x_1999:xhtmla/>
      </x_1999:xhtmltd>
      <x_1999:xhtmlth rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Range:</x_1999:xhtmlth>
    </x_1999:xhtmltr>
  </x_1999:xhtmltable>
  <x_1999:xhtmlp>
    <x_1999:xhtmlcode>
      <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:Organization</x_1999:xhtmla>
    </x_1999:xhtmlcode>
  </x_1999:xhtmlp>
  <x_1999:xhtmldiv>
    <x_1999:xhtmlpre/>
  </x_1999:xhtmldiv>
  <x_1999:xhtmlp>
    <x_1999:xhtmlcode>
      <x_1999:xhtmla rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foaf:Organization</x_1999:xhtmla>
    </x_1999:xhtmlcode>
  </x_1999:xhtmlp>
  <x_1999:xhtmlp>
    <x_1999:xhtmla/>
  </x_1999:xhtmlp>
  <x_1999:xhtmlh3 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property: foaf:workplaceHomepage</x_1999:xhtmlh3>
  <x_1999:xhtmlem rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workplace homepage</x_1999:xhtmlem>
  <x_1999:xhtmlbr rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></x_1999:xhtmlbr>
  <x_1999:xhtmlp rdf:datatype="http://www.w3.org/2001/XMLSchema#string">
By directly relating people to the homepages of their workplace, we have a simple convention 
that takes advantage of a set of widely known identifiers, while taking care not to confuse the 
things those identifiers identify (ie. organizational homepages) with the actual organizations 
those homepages describe.
</x_1999:xhtmlp>
</x_1999:xhtmldiv>

